<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>StripperClips.Fika</AssemblyName>
    <Version>1.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
    <PathMap>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))=/_/</PathMap>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SptRoot Condition="'$(SptRoot)' == ''">$(SPT_ROOT)</SptRoot>
    <Managed>$(SptRoot)\EscapeFromTarkov_Data\Managed</Managed>
    <FikaCore Condition="'$(FikaCore)' == ''">$(SptRoot)\BepInEx\plugins\Fika\Fika.Core.dll</FikaCore>
  </PropertyGroup>
  <Target Name="RequireFika" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(FikaCore)')" Text="Supply -p:FikaCore with the installed Fika.Core 2.4.6.0 DLL." />
  </Target>
  <ItemGroup>
    <Reference Include="StripperClips"><HintPath>..\client\bin\$(Configuration)\StripperClips.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Fika.Core"><HintPath>$(FikaCore)</HintPath><Private>false</Private></Reference>
    <GameReference Include="Assembly-CSharp;Comfort;Comfort.Unity;Sirenix.Serialization;UnityEngine;UnityEngine.CoreModule;UnityEngine.AnimationModule" />
    <Reference Include="@(GameReference)">
      <HintPath>$(Managed)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx"><HintPath>$(SptRoot)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(SptRoot)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
